
/*
The user provided config file can provide settings in addition to the the settings in the nextflow.config file.
Here's some examples on how you can write your own config file.
Command example with config file:
nextflow run main.nf -c usr_template.config

For more settings: https://www.nextflow.io/docs/latest/reference/config.html#config-options
*/

executor.queueSize = 1
workDir = "work/mock_test"
process {
	cpus = params.threads
	executor = 'local'
	withName: assemble_metagenome {
                cpus = 16
                }
	withName: map_samples {
                cpus = 8
                }
	withName: binning {
                cpus = 10
                }
	withName: dastool {
                cpus = 4
                }
	withName: checkbins {
                cpus = 20
                }
}
